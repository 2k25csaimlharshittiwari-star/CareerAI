CAREERAI_ENV=production
CAREERAI_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CAREERAI_ALLOWED_ORIGINS=https://your-domain.example
CAREERAI_DB_PATH=./data/careerai.db
CAREERAI_UPLOAD_DIR=./data/uploads
CAREERAI_MAX_UPLOAD_MB=5

# Optional LLM integration
# Keep this server-side only. Never put the key in frontend/app.js.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
